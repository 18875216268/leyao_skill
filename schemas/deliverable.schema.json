{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Deliverable specification",
  "type":"object",
  "required":["object_type","id","name","kind","type","status","bindings","outputs","required_gates"],
  "properties":{
    "object_type":{"const":"deliverable_spec"},
    "schema_version":{"type":"integer","minimum":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "version":{"type":"integer","minimum":1},
    "name":{"type":"string","minLength":1},
    "kind":{"enum":["report","retrospective","template","other"]},
    "type":{"type":"string","minLength":1},
    "status":{"enum":["draft","active","paused","archived"]},
    "period":{"type":"object"},
    "scope":{"type":"object"},
    "bindings":{"type":"array","items":{"type":"object","required":["binding_id","task_id","required","selector"],"properties":{"binding_id":{"type":"string"},"task_id":{"type":"string"},"role":{"type":"string"},"required":{"type":"boolean"},"selector":{"type":"object"}}}},
    "content":{"type":"object"},
    "template_id":{"type":["string","null"]},
    "outputs":{"type":"array","minItems":1,"items":{"type":"object","required":["output_id","format","destination"],"properties":{"output_id":{"type":"string"},"format":{"type":"string"},"destination":{"type":"string"}}}},
    "schedule":{"type":["object","null"]},
    "required_gates":{"type":"array","minItems":4,"items":{"enum":["intent","data","calculation","delivery"]}}
  }
}
